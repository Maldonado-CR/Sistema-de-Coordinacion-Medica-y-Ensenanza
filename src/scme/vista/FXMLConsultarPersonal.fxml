<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="820.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLConsultarPersonalController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Catálogo de Personal (SCME-CU4)" textFill="#0F172A">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="Consulte los usuarios registrados con rol Administrativo, Tutor o Coordinación." textFill="#64748B">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <Button fx:id="btnNuevoPersonal" mnemonicParsing="false" prefHeight="36.0" prefWidth="150.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Nuevo Personal" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField fx:id="txtFiltroBusqueda" prefHeight="36.0" promptText="Filtrar por matrícula, nombre o correo..." HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="cmbFiltroRol" prefHeight="36.0" prefWidth="180.0" promptText="Todos los roles" />
                  <Button fx:id="btnLimpiarFiltros" mnemonicParsing="false" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpiar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tblPersonal" prefHeight="330.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colMatricula" prefWidth="110.0" text="ID / Matrícula" />
                  <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre Completo" />
                  <TableColumn fx:id="colCorreo" prefWidth="210.0" text="Correo Electrónico" />
                  <TableColumn fx:id="colRol" prefWidth="120.0" text="Rol" />
                  <TableColumn fx:id="colEstado" prefWidth="95.0" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnVerDetalle" mnemonicParsing="false" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #0F172A; -fx-background-radius: 6; -fx-cursor: hand;" text="Ver Detalles" textFill="WHITE">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Regresar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>