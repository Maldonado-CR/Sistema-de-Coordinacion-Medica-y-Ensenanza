<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLAsignarCalificacionController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Captura de Calificaciones Finales (SCME-CU23)" textFill="#0F172A">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
                  <Label text="Seleccione un curso para registrar las evaluaciones finales (escala 0.00 a 10.00)." textFill="#64748B">
                     <font><Font size="13.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Seleccionar Curso *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                  <ComboBox fx:id="cmbCurso" maxWidth="1.7976931348623157E308" onAction="#accionCargarInscritos" prefHeight="36.0" promptText="-- Elija un curso --" />
               </children>
            </VBox>
            <TableView fx:id="tblCalificaciones" editable="true" prefHeight="300.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colMatricula" editable="false" prefWidth="130.0" text="Matrícula" />
                  <TableColumn fx:id="colEstudiante" editable="false" prefWidth="330.0" text="Nombre del Estudiante" />
                  <TableColumn fx:id="colCalificacion" prefWidth="160.0" text="Calificación Final" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" textFill="#334155">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="btnGuardarCalificaciones" mnemonicParsing="false" onAction="" prefHeight="38.0" prefWidth="175.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar Calificaciones" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>