<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="840.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLConsultarHorarioController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Consulta de Horarios y Guardias (SCME-CU15)" textFill="#0F172A">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
                  <Label text="Visualice los turnos clínicos y guardias programadas por estudiante o área." textFill="#64748B">
                     <font><Font size="13.0" /></font>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField fx:id="txtBuscar" prefHeight="36.0" promptText="Buscar por matrícula o nombre del estudiante..." HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="cmbFiltroEstado" prefHeight="36.0" prefWidth="170.0" promptText="Estado de guardia" />
                  <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#accionBuscar" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Filtrar" textFill="WHITE">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tblHorarios" prefHeight="340.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colEstudiante" prefWidth="200.0" text="Estudiante" />
                  <TableColumn fx:id="colArea" prefWidth="140.0" text="Área Clínica" />
                  <TableColumn fx:id="colFechaInicio" prefWidth="145.0" text="Inicio" />
                  <TableColumn fx:id="colFechaFin" prefWidth="145.0" text="Fin" />
                  <TableColumn fx:id="colHoras" prefWidth="75.0" text="Horas" />
                  <TableColumn fx:id="colEstado" prefWidth="105.0" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#accionRegresar" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Regresar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>