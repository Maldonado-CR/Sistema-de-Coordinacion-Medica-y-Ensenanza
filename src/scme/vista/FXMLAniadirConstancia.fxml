<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="440.0" prefWidth="560.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLAniadirConstanciaController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Subir Constancia de Curso (SCME-CU20)" textFill="#0F172A">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
                  <Label text="Adjunte su comprobante oficial en formato PDF (tamaño máximo: 10 MB)." textFill="#64748B">
                     <font><Font size="13.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox spacing="14.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Curso Inscrito *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <ComboBox fx:id="cmbCursoInscrito" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="-- Seleccione el curso completado --" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Archivo PDF de Constancia *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <HBox spacing="10.0">
                           <children>
                              <TextField fx:id="txtRutaArchivo" editable="false" prefHeight="36.0" promptText="Ningún archivo seleccionado..." style="-fx-background-color: #F1F5F9;" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnExaminar" mnemonicParsing="false" onAction="#accionSeleccionarPDF" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #334155; -fx-background-radius: 6; -fx-cursor: hand;" text="Examinar PDF" textFill="WHITE">
                                 <font><Font name="System Bold" size="12.0" /></font>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <Label style="-fx-background-color: #FEF3C7; -fx-padding: 10; -fx-background-radius: 6;" text="Importante: El documento quedará en estado 'Pendiente' hasta ser dictaminado por Coordinación." textFill="#92400E" wrapText="true">
               <font><Font size="12.0" /></font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <VBox.margin><Insets top="6.0" /></VBox.margin>
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" textFill="#334155">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="btnSubirConstancia" mnemonicParsing="false" onAction="" prefHeight="38.0" prefWidth="150.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Enviar Constancia" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>