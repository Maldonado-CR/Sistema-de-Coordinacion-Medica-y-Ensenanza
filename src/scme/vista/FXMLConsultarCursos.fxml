<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="820.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLConsultarCursosController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Catálogo de Cursos (SCME-CU11)" textFill="#0F172A">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="Visualice los cursos registrados, sus periodos y disponibilidad de cupo." textFill="#64748B">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <Button fx:id="btnNuevoCurso" mnemonicParsing="false" onAction="#accionNuevoCurso" prefHeight="36.0" prefWidth="150.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Nuevo Curso" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField fx:id="txtBuscarCurso" prefHeight="36.0" promptText="Buscar por ID o nombre del curso..." HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="cmbFiltroEstado" prefHeight="36.0" prefWidth="170.0" promptText="Todos los estados" />
                  <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#accionLimpiar" prefHeight="36.0" prefWidth="95.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpiar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tblCursos" prefHeight="330.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colIdCurso" prefWidth="85.0" text="ID Curso" />
                  <TableColumn fx:id="colNombreCurso" prefWidth="260.0" text="Nombre del Curso" />
                  <TableColumn fx:id="colPeriodo" prefWidth="170.0" text="Periodo" />
                  <TableColumn fx:id="colCupo" prefWidth="110.0" text="Cupo Máx." />
                  <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnVerInscritos" mnemonicParsing="false" prefHeight="36.0" prefWidth="150.0" style="-fx-background-color: #0F172A; -fx-background-radius: 6; -fx-cursor: hand;" text="Ver Inscritos" textFill="WHITE">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Regresar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>