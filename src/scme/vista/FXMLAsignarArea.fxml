<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="540.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLAsignarAreaController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Asignar Área Clínica (SCME-CU8)" textFill="#0F172A">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
                  <Label text="Vincule un estudiante activo a un departamento o área de rotación." textFill="#64748B">
                     <font><Font size="13.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox spacing="14.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="1. Seleccionar Estudiante *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <ComboBox fx:id="cmbEstudiante" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="-- Elija un estudiante --" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="2. Asignar Área Clínica *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <ComboBox fx:id="cmbAreaClinica" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="-- Elija un área --" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="3. Fecha de Inicio en Área *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <DatePicker fx:id="dpFechaAsignacion" maxWidth="1.7976931348623157E308" prefHeight="36.0" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <Label style="-fx-background-color: #EFF6FF; -fx-padding: 10; -fx-background-radius: 6;" text="Nota: La asignación actualizará el historial de rotaciones del estudiante." textFill="#1D4ED8" wrapText="true">
               <font><Font size="12.0" /></font>
            </Label>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <VBox.margin><Insets top="6.0" /></VBox.margin>
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" textFill="#334155">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="btnConfirmarAsignacion" mnemonicParsing="false" prefHeight="38.0" prefWidth="170.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Confirmar Asignación" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>