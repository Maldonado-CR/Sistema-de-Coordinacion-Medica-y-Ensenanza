<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="440.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLIniciarSesionController">
   <children>
      <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="35.0">
         <padding>
            <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label text="SCME — Unidad Médica" textFill="#2563EB">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Label>
                  <Label text="Iniciar Sesión (SCME-CU1)" textFill="#0F172A">
                     <font><Font name="System Bold" size="22.0" /></font>
                  </Label>
                  <Label text="Ingrese sus credenciales institucionales" textFill="#64748B">
                     <font><Font size="13.0" /></font>
                  </Label>
               </children>
            </VBox>
            <VBox spacing="14.0" prefWidth="300.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Matrícula / Usuario *" textFill="#334155">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <TextField fx:id="txtUsuario" prefHeight="38.0" promptText="Ej. S24013286 o correo" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Contraseña *" textFill="#334155">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <PasswordField fx:id="txtPassword" prefHeight="38.0" promptText="••••••••••••" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            <Label fx:id="lblErrorLogin" textFill="#DC2626" visible="false">
               <font><Font size="12.0" /></font>
            </Label>
            <Button fx:id="btnIngresar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Ingresar al Sistema" textFill="WHITE">
               <font><Font name="System Bold" size="14.0" /></font>
            </Button>
            <Hyperlink fx:id="lnkOlvidePassword" text="¿Olvidaste tu contraseña?" textFill="#2563EB">
               <font><Font size="12.0" /></font>
            </Hyperlink>
         </children>
      </VBox>
   </children>
</AnchorPane>