<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="560.0" prefWidth="720.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLAsignarCursoController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Inscribir Estudiantes a Curso (SCME-CU13)" textFill="#0F172A">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
                  <Label text="Seleccione un curso activo y elija los estudiantes disponibles para inscribir." textFill="#64748B">
                     <font><Font size="13.0" /></font>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Curso Activo *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <ComboBox fx:id="cmbCursoActivo" maxWidth="1.7976931348623157E308" onAction="#accionFiltrarDisponibles" prefHeight="36.0" promptText="-- Seleccione un curso --" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" prefWidth="170.0">
                     <children>
                        <Label text="Cupos Disponibles" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <Label fx:id="lblCuposDisponibles" alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="36.0" style="-fx-background-color: #EFF6FF; -fx-background-radius: 6; -fx-border-color: #BFDBFE; -fx-border-radius: 6;" text="-- / --" textFill="#1D4ED8">
                           <font><Font name="System Bold" size="14.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label text="Estudiantes Disponibles (sin inscripción previa en este curso):" textFill="#334155">
               <font><Font name="System Bold" size="12.0" /></font>
            </Label>
            <TableView fx:id="tblEstudiantesDisponibles" prefHeight="260.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colSeleccionar" prefWidth="75.0" text="Asignar" />
                  <TableColumn fx:id="colMatricula" prefWidth="120.0" text="Matrícula" />
                  <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre Completo" />
                  <TableColumn fx:id="colEspecialidad" prefWidth="170.0" text="Especialidad" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#accionCancelar" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" textFill="#334155">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="btnAsignar" mnemonicParsing="false" onAction="#accionAsignar" prefHeight="38.0" prefWidth="165.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Inscribir Seleccionados" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>