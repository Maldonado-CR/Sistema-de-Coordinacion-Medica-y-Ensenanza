<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="840.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLConsultarConstanciasController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Historial de Constancias (SCME-CU21)" textFill="#0F172A">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="Revise el estatus de validación, observaciones y archivos PDF enviados." textFill="#64748B">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <ComboBox fx:id="cmbFiltroEstado" prefHeight="36.0" prefWidth="180.0" promptText="Todos los estados" />
               </children>
            </HBox>
            <TableView fx:id="tblConstancias" prefHeight="350.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colEstudiante" prefWidth="190.0" text="Estudiante" />
                  <TableColumn fx:id="colCurso" prefWidth="210.0" text="Curso" />
                  <TableColumn fx:id="colFechaCarga" prefWidth="130.0" text="Fecha Carga" />
                  <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                  <TableColumn fx:id="colComentarios" prefWidth="170.0" text="Observaciones" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnAbrirPDF" mnemonicParsing="false" onAction="" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Visualizar PDF" textFill="WHITE">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Regresar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
