<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="840.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLConsultarAsistenciasController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Historial de Asistencias (SCME-CU18)" textFill="#0F172A">
                     <font><Font name="System Bold" size="20.0" /></font>
                  </Label>
                  <Label text="Consulte los registros de entrada y salida normales o extemporáneos." textFill="#64748B">
                     <font><Font size="13.0" /></font>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="txtBuscarEstudiante" prefHeight="36.0" promptText="Matrícula o nombre..." HBox.hgrow="ALWAYS" />
                  <DatePicker fx:id="dpFechaDesde" prefHeight="36.0" prefWidth="145.0" promptText="Desde" />
                  <DatePicker fx:id="dpFechaHasta" prefHeight="36.0" prefWidth="145.0" promptText="Hasta" />
                  <Button fx:id="btnFiltrar" mnemonicParsing="false" onAction="#accionFiltrar" prefHeight="36.0" prefWidth="95.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="Filtrar" textFill="WHITE">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tblAsistencias" prefHeight="340.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colMatricula" prefWidth="110.0" text="Matrícula" />
                  <TableColumn fx:id="colNombre" prefWidth="210.0" text="Estudiante" />
                  <TableColumn fx:id="colFechaHora" prefWidth="165.0" text="Fecha y Hora" />
                  <TableColumn fx:id="colMovimiento" prefWidth="105.0" text="Movimiento" />
                  <TableColumn fx:id="colTipoAsistencia" prefWidth="115.0" text="Modalidad" />
                  <TableColumn fx:id="colAutorizo" prefWidth="110.0" text="Autorizó" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Regresar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
