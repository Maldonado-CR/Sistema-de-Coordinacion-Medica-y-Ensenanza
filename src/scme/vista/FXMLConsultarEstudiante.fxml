<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="860.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="scme.controlador.FXMLConsultarEstudianteController">
   <children>
      <VBox spacing="18.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <padding>
            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Catálogo de Estudiantes (SCME-CU6)" textFill="#0F172A">
                           <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Label text="Consulte los practicantes y residentes registrados en la Unidad Médica." textFill="#64748B">
                           <font><Font size="13.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <Button fx:id="btnNuevoEstudiante" mnemonicParsing="false" prefHeight="36.0" prefWidth="160.0" style="-fx-background-color: #2563EB; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Nuevo Estudiante" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField fx:id="txtBuscarEstudiante" prefHeight="36.0" promptText="Buscar por matrícula o nombre completo..." HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="cmbFiltroEspecialidad" prefHeight="36.0" prefWidth="190.0" promptText="Todas las especialidades" />
                  <Button fx:id="btnLimpiar" mnemonicParsing="false" prefHeight="36.0" prefWidth="95.0" style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Limpiar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tblEstudiantes" prefHeight="330.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colMatricula" prefWidth="110.0" text="Matrícula" />
                  <TableColumn fx:id="colNombre" prefWidth="210.0" text="Nombre Completo" />
                  <TableColumn fx:id="colEspecialidad" prefWidth="145.0" text="Especialidad" />
                  <TableColumn fx:id="colArea" prefWidth="140.0" text="Área Asignada" />
                  <TableColumn fx:id="colEstado" prefWidth="95.0" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnVerPerfil" mnemonicParsing="false" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #0F172A; -fx-background-radius: 6; -fx-cursor: hand;" text="Ver Historial" textFill="WHITE">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
                  <Button fx:id="btnRegresar" mnemonicParsing="false" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Regresar" textFill="#334155">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

